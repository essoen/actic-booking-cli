#!/usr/bin/env python3
"""View and book group fitness classes at Actic (minesider.actic.no).

Uses the same API as the web app: https://webapi.actic.se/ with an opaque
bearer token from login. The token is cached in ~/.config/actic/token.json
and refreshed automatically when check-auth-token fails.

There is no separate waiting list endpoint — the same POST puts you on the
waiting list when a class is full, so `book` requires an explicit --waitlist
in that case.

Credentials are read from ACTIC_USERNAME / ACTIC_PASSWORD, either as
environment variables or from an env file (see CONFIG_FILES). No secrets are
stored in this repository.
"""

import argparse
import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path

import requests

API = os.environ.get("ACTIC_API", "https://webapi.actic.se/")

# Token cache. Override with ACTIC_TOKEN_FILE.
STATE = Path(os.environ.get(
    "ACTIC_TOKEN_FILE", Path.home() / ".config" / "actic" / "token.json"))

# Env files read when the variables are not already in the environment.
# ACTIC_ENV_FILE takes precedence over everything else.
CONFIG_FILES = [Path(p).expanduser() for p in filter(None, [
    os.environ.get("ACTIC_ENV_FILE"),
    Path.home() / ".config" / "actic" / "env",
    Path.cwd() / ".env",
])]

# Center ID. Defaults to the home center on your membership; override with
# ACTIC_CENTER or --center. Run `actic centers` to list IDs.
DEFAULT_CENTER = int(os.environ["ACTIC_CENTER"]) if os.environ.get("ACTIC_CENTER") else None
DEFAULT_COUNTRY = os.environ.get("ACTIC_COUNTRY", "NO")

HEADERS = {
    "Content-Type": "application/json",
    "Accept": "application/json, text/plain, */*",
    "Origin": "https://minesider.actic.no",
    "Referer": "https://minesider.actic.no/",
}


class ActicError(Exception):
    pass


def load_env(name):
    val = os.environ.get(name)
    if val:
        return val
    for path in CONFIG_FILES:
        if not path.exists():
            continue
        for line in path.read_text().splitlines():
            m = re.match(r'\s*(?:export\s+)?([A-Z_]+)\s*=\s*(.*)', line)
            if m and m.group(1) == name:
                return m.group(2).strip().strip('"').strip("'")
    return None


class Actic:
    def __init__(self):
        self.session = requests.Session()
        self.session.headers.update(HEADERS)
        self.token = None
        self.person_id = None
        self.home_center = None
        self._load_cache()

    # --- auth ---------------------------------------------------------
    def _load_cache(self):
        if STATE.exists():
            data = json.loads(STATE.read_text())
            self.token = data.get("token")
            self.person_id = data.get("externalId")
            self.home_center = data.get("homeCenter")

    def _save_cache(self):
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps({"token": self.token, "externalId": self.person_id,
                                     "homeCenter": self.home_center}))
        STATE.chmod(0o600)

    def _auth_header(self):
        # The web app sends the token in both headers; the data endpoints
        # reject requests that only carry Authorization.
        return {"Authorization": "Bearer " + self.token, "Access-Token": self.token}

    def ensure_auth(self):
        if self.token and self.person_id:
            r = self.session.post(API + "check-auth-token", json={"privilege": False},
                                  headers=self._auth_header(), timeout=30)
            if r.ok and r.json().get("success"):
                return
        self.login()

    def login(self):
        user = load_env("ACTIC_USERNAME")
        pw = load_env("ACTIC_PASSWORD")
        if not user or not pw:
            raise ActicError(
                "Missing ACTIC_USERNAME / ACTIC_PASSWORD. Set them as environment "
                "variables, or put them in %s (see .env.example)." % CONFIG_FILES[-1])
        r = self.session.post(API + "login", json={"username": user, "password": pw}, timeout=30)
        if not r.ok:
            raise ActicError("Login failed (HTTP %d)" % r.status_code)
        data = r.json()
        if not data.get("success") or not data.get("accessToken"):
            raise ActicError("Login rejected — check your username and password")
        self.token = data["accessToken"]
        self.person_id = data["person"]["personId"]["externalId"]
        self.home_center = data["person"]["personId"].get("center")
        self._save_cache()

    # --- requests -----------------------------------------------------
    def call(self, method, path, **kw):
        self.ensure_auth()
        r = self.session.request(method, API + path, headers=self._auth_header(), timeout=30, **kw)
        if r.status_code in (401, 403):
            self.login()
            r = self.session.request(method, API + path, headers=self._auth_header(), timeout=30, **kw)
        if not r.ok:
            try:
                err = r.json().get("error") or r.text[:200]
            except ValueError:
                err = r.text[:200]
            raise ActicError("%s %s failed (HTTP %d): %s" % (method, path, r.status_code, err))
        return r.json()

    def person(self):
        """externalId — requires a valid session, since it is part of every URL."""
        self.ensure_auth()
        return self.person_id

    def default_centers(self):
        """Centers to use when the caller did not pick any."""
        if DEFAULT_CENTER:
            return [DEFAULT_CENTER]
        self.ensure_auth()
        if not self.home_center:
            # Cache written before home center was tracked — refresh it.
            self.login()
        if not self.home_center:
            raise ActicError("Could not determine your home center — pass --center "
                             "or set ACTIC_CENTER (see `actic centers`).")
        return [self.home_center]

    def centers(self, country=DEFAULT_COUNTRY):
        return self.call("GET", "db/centers/%s" % country)

    def classes(self, centers=None):
        ids = ",".join(str(c) for c in (centers or self.default_centers()))
        return self.call("GET", "persons/%s/centers/%s/classesAll" % (self.person(), ids))

    def participations(self):
        return self.call("GET", "persons/%s/participations/classes" % self.person())

    def book(self, booking_compound):
        return self.call("POST", "persons/%s/participations/%s" % (self.person(), booking_compound))

    def cancel(self, booking_compound, participation_compound):
        return self.call("DELETE", "persons/%s/participations/%s/%s"
                         % (self.person(), booking_compound, participation_compound))


# --- helpers ----------------------------------------------------------
def compound(key):
    return "%sp%s" % (key["center"], key["id"])


def flatten(classes_payload):
    out = []
    for date in sorted(classes_payload.get("classes", {})):
        for c in classes_payload["classes"][date]:
            out.append(c)
    return out


def summarize(c):
    """Shared, machine-readable shape of a class."""
    remaining = c.get("classCapacityRemaning", 0)
    booked = bool(c.get("participation"))
    state = c.get("bookingState", "")
    if booked:
        status = "BOOKED"
    elif state.startswith("NOT_BOOKABLE"):
        status = "NOT_BOOKABLE"
    elif remaining <= 0:
        status = "WAITINGLIST"
    else:
        status = "BOOKABLE"
    return {
        "id": c.get("bookingIdCompound"),
        "date": c.get("date"),
        "start": c.get("startTime"),
        "end": c.get("endTime"),
        "name": c.get("name"),
        "instructor": c.get("instructorNames"),
        "room": c.get("roomNames"),
        "center": c.get("centerName"),
        "capacity": c.get("classCapacity"),
        "booked_count": c.get("bookedCount"),
        "remaining": remaining,
        "waiting_list": c.get("waitingListCount", 0),
        "waiting_list_capacity": (c.get("activity") or {}).get("waitingListCapacity"),
        "status": status,
        "state_info": c.get("stateInfo"),
    }


DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]


def weekday(date_str):
    return DAYS[datetime.strptime(date_str, "%Y-%m-%d").weekday()]


def fmt(s):
    line = "%s %s %s-%s  %s" % (weekday(s["date"]), s["date"], s["start"], s["end"], s["name"])
    if s["status"] == "BOOKED":
        tail = "BOOKED"
    elif s["status"] == "WAITINGLIST":
        tail = "full (%d on waiting list)" % s["waiting_list"]
    elif s["status"] == "NOT_BOOKABLE":
        tail = "not bookable"
    else:
        tail = "%d spots left" % s["remaining"]
    return "%s  [%s]  %s  - %s" % (line, s["id"], tail, s["instructor"] or "")


def find_class(items, needle):
    """Matches on bookingIdCompound, or on free text like "WOD 2026-09-14 06:30"."""
    for s in items:
        if s["id"] == needle:
            return s
    parts = needle.lower().split()
    matches = [s for s in items
               if all(p in " ".join(filter(None, [s["name"], s["date"], s["start"]])).lower()
                      for p in parts)]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        raise ActicError('Several classes match "%s":\n%s'
                         % (needle, "\n".join(fmt(m) for m in matches)))
    return None


# --- commands ---------------------------------------------------------
def cmd_classes(api, args):
    payload = api.classes(args.center)
    items = [summarize(c) for c in flatten(payload)]
    if args.name:
        items = [s for s in items if args.name.lower() in (s["name"] or "").lower()]
    if args.date:
        items = [s for s in items if s["date"] == args.date]
    if args.days:
        dates = sorted({s["date"] for s in items})[:args.days]
        items = [s for s in items if s["date"] in dates]
    if args.bookable:
        items = [s for s in items if s["status"] in ("BOOKABLE", "WAITINGLIST")]
    if args.json:
        print(json.dumps({
            "participations_count": payload.get("participations_count"),
            "participations_max": payload.get("participations_max"),
            "booking_starts_days_before": payload.get("booking_starts_days_before"),
            "classes": items,
        }, ensure_ascii=False, indent=2))
        return
    print("%s of %s bookings used\n" % (payload.get("participations_count"),
                                        payload.get("participations_max")))
    for s in items:
        print(fmt(s))


def cmd_bookings(api, args):
    parts = api.participations()
    if isinstance(parts, dict):
        parts = list(parts.values())
    rows = []
    for p in parts:
        b = p.get("booking", {})
        rows.append({
            "id": compound(b["bookingId"]),
            "participation_id": compound(p["participationId"]),
            "date": b.get("date"),
            "start": b.get("startTime"),
            "end": b.get("endTime"),
            "name": b.get("name"),
            "instructor": b.get("instructorNames"),
            "room": b.get("roomNames"),
            "state": p.get("state"),
        })
    rows.sort(key=lambda r: (r["date"] or "", r["start"] or ""))
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return
    if not rows:
        print("No bookings.")
        return
    for r in rows:
        print("%s %s %s-%s  %s  [%s]  %s - %s"
              % (weekday(r["date"]), r["date"], r["start"], r["end"], r["name"], r["id"],
                 r["state"], r["instructor"] or ""))


def cmd_book(api, args):
    payload = api.classes(args.center)
    items = [summarize(c) for c in flatten(payload)]
    target = find_class(items, args.klass)
    if not target:
        raise ActicError('No class matches "%s"' % args.klass)
    if target["status"] == "BOOKED":
        raise ActicError("Already booked: %s" % fmt(target))
    if target["status"] == "NOT_BOOKABLE":
        raise ActicError("Not bookable: %s (%s)" % (fmt(target), target["state_info"]))
    if target["status"] == "WAITINGLIST" and not args.waitlist:
        print("FULL: %s" % fmt(target), file=sys.stderr)
        print("This class is full. Run again with --waitlist to take a waiting list "
              "spot (%d of %s waiting list spots used)."
              % (target["waiting_list"], target["waiting_list_capacity"]), file=sys.stderr)
        sys.exit(2)
    res = api.book(target["id"])
    if not res.get("success"):
        raise ActicError("Booking failed: %s" % json.dumps(res, ensure_ascii=False)[:300])
    p = res.get("participation", {})
    if args.json:
        print(json.dumps({
            "booked": target,
            "state": p.get("state"),
            "participation_id": compound(p["participationId"]) if p.get("participationId") else None,
            "participations_count": res.get("participations_count"),
            "participations_max": res.get("participations_max"),
        }, ensure_ascii=False, indent=2))
        return
    word = "Added to waiting list for" if p.get("state") == "WAITING_LIST" else "Booked"
    print("%s %s (%s/%s bookings used)"
          % (word, fmt(target), res.get("participations_count"), res.get("participations_max")))


def cmd_cancel(api, args):
    parts = api.participations()
    if isinstance(parts, dict):
        parts = list(parts.values())
    hit = None
    for p in parts:
        b = p.get("booking", {})
        bid = compound(b["bookingId"])
        haystack = " ".join(filter(None, [bid, b.get("name"), b.get("date"), b.get("startTime")])).lower()
        if bid == args.klass or all(t in haystack for t in args.klass.lower().split()):
            if hit:
                raise ActicError('Several bookings match "%s" — use the booking ID.' % args.klass)
            hit = (bid, compound(p["participationId"]), b)
    if not hit:
        raise ActicError('No booking matches "%s"' % args.klass)
    bid, pid, b = hit
    res = api.cancel(bid, pid)
    if not res.get("success"):
        raise ActicError("Cancellation failed: %s" % json.dumps(res, ensure_ascii=False)[:300])
    if args.json:
        print(json.dumps({"cancelled": bid, "date": b.get("date"), "name": b.get("name"),
                          "participations_count": res.get("participations_count")},
                         ensure_ascii=False, indent=2))
        return
    print("Cancelled %s %s %s (%s/%s bookings used)"
          % (b.get("name"), b.get("date"), b.get("startTime"),
             res.get("participations_count"), res.get("participations_max")))


def cmd_centers(api, args):
    data = api.centers(args.country)
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    for c in data:
        print("%s  %s (%s)" % (c["centerId"], c["name"], c.get("city") or ""))


def main():
    ap = argparse.ArgumentParser(
        description="Actic group classes: view the schedule, book and cancel.")
    ap.add_argument("--json", action="store_true", help="machine-readable output")

    # Shared so that --json works both before and after the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")

    sub = ap.add_subparsers(dest="cmd", required=True)

    def center_arg(p):
        default_help = str(DEFAULT_CENTER) if DEFAULT_CENTER else "your home center"
        p.add_argument("--center", type=int, action="append", default=None,
                       help="center ID (repeatable). Default: %s" % default_help)

    p = sub.add_parser("classes", parents=[common], help="show the class schedule")
    center_arg(p)
    p.add_argument("--days", type=int, help="number of days ahead")
    p.add_argument("--date", help="only this date (YYYY-MM-DD)")
    p.add_argument("--name", help="filter by class name, e.g. WOD")
    p.add_argument("--bookable", action="store_true", help="hide classes that cannot be booked")
    p.set_defaults(func=cmd_classes)

    p = sub.add_parser("bookings", aliases=["mine"], parents=[common], help="show your own bookings")
    p.set_defaults(func=cmd_bookings)

    p = sub.add_parser("book", parents=[common], help="book a class")
    p.add_argument("klass", metavar="CLASS",
                   help='booking ID (544p144115) or free text ("WOD 2026-09-14 06:30")')
    p.add_argument("--waitlist", action="store_true",
                   help="accept a waiting list spot if the class is full")
    center_arg(p)
    p.set_defaults(func=cmd_book)

    p = sub.add_parser("cancel", parents=[common], help="cancel a booking")
    p.add_argument("klass", metavar="CLASS", help="booking ID or free text")
    p.set_defaults(func=cmd_cancel)

    p = sub.add_parser("centers", parents=[common], help="list centers")
    p.add_argument("--country", default=DEFAULT_COUNTRY)
    p.set_defaults(func=cmd_centers)

    args = ap.parse_args()
    try:
        args.func(Actic(), args)
    except ActicError as e:
        print("Error: %s" % e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
