# Kopier til ~/.config/actic/env (chmod 600) eller sett som miljøvariabler.
ACTIC_USERNAME=din-innlogging-pa-minesider
ACTIC_PASSWORD=ditt-passord

# Valgfritt
# ACTIC_CENTER=544            # senter-ID, se `actic centers`
# ACTIC_COUNTRY=NO            # NO, SE eller DE
# ACTIC_TOKEN_FILE=~/.config/actic/token.json
