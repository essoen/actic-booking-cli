# Copy to ~/.config/actic/env (chmod 600) or set as environment variables.
ACTIC_USERNAME=your-my-pages-login
ACTIC_PASSWORD=your-password

# Optional
# ACTIC_CENTER=544            # center ID; defaults to your home center. See `actic centers`
# ACTIC_COUNTRY=NO            # NO, SE or DE
# ACTIC_TOKEN_FILE=~/.config/actic/token.json
